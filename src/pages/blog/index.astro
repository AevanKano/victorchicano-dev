---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export interface Props {}

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog Técnico | Víctor Chicano"
  description="Artículos sobre arquitectura frontend, ingeniería cloud, DevOps y rendimiento web."
>
  <main class="max-w-3xl mx-auto px-6 py-12">
    <header class="space-y-3 mb-12">
      <h1 class="text-3xl font-bold tracking-tight text-white">
        Blog Técnico
      </h1>
      <p class="text-neutral-400 text-sm leading-relaxed">
        Artículos, lecciones aprendidas y notas de ingeniería sobre desarrollo frontend, infraestructura cloud y DevOps.
      </p>
    </header>

    <div class="space-y-8">
      {
        posts.map((post) => (
          <article class="group relative flex flex-col items-start p-6 -mx-6 rounded-2xl transition-colors hover:bg-neutral-900/40 border border-transparent hover:border-neutral-800/60">
            <div class="flex items-center gap-3 mb-2">
              <FormattedDate date={post.data.pubDate} />
              <div class="flex items-center gap-1.5">
                {post.data.tags.map((tag) => (
                  <span class="text-xs px-2 py-0.5 rounded font-mono bg-neutral-900 text-neutral-400 border border-neutral-800">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <h2 class="text-xl font-semibold text-neutral-100 group-hover:text-emerald-400 transition-colors">
              <a href={`/blog/${post.slug}`}>
                <span class="absolute -inset-y-0 -inset-x-0 sm:rounded-2xl" />
                {post.data.title}
              </a>
            </h2>

            <p class="mt-2 text-sm text-neutral-400 leading-relaxed">
              {post.data.description}
            </p>

            <span class="mt-4 inline-flex items-center text-xs font-mono font-medium text-emerald-400 group-hover:translate-x-1 transition-transform">
              Leer artículo →
            </span>
          </article>
        ))
      }
    </div>
  </main>
</Layout>
