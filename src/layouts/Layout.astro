---
import Header from '../components/Header.astro';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Blog y portfolio personal' } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-neutral-950 text-neutral-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased flex flex-col justify-between selection:bg-neutral-800 selection:text-neutral-100">
    <div>
      <Header />
      <slot />
    </div>
    
    <footer class="border-t border-neutral-900 py-8 text-center text-xs font-mono text-neutral-400">
      <div class="max-w-3xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© {new Date().getFullYear()} Víctor Chicano. Todos los derechos reservados.</p>
        <p class="text-neutral-400">Construido con Astro & Tailwind CSS</p>
      </div>
    </footer>
  </body>
</html>
